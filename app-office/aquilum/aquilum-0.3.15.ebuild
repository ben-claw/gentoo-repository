RESTRICT="mirror"

# ${P} is not used because directory name starts with capital letter.
S="${WORKDIR}/Aquilum-${PV}/${MY_PN}"

DEPEND="
	dev-libs/glib:2
	media-libs/fontconfig
	media-libs/gstreamer
	>=media-libs/gst-plugins-base-1.14
"

RDEPEND="
	dev-libs/glib
	media-libs/fontconfig
	media-libs/freetype
	media-libs/gstreamer
	media-libs/gst-plugins-base
	media-libs/gst-plugins-good
	x11-libs/libX11
	x11-libs/libXcursor
	x11-libs/libXrandr
	x11-libs/libXi
	x11-libs/libxcb
	x11-libs/libxkbcommon
	dev-libs/wayland
	|| (
		sys-apps/xdg-desktop-portal
		gnome-extra/zenity
	)
	!app-office/aquilum-bin
"

src_install() {
	newbin ../.artifacts/cargo-native/release/aquilum-native ${MY_PN}
	domenu native/packaging/Aquilum.desktop
	for size in 32 128 ; do
		newicon --size ${size} native/icons/${size}x${size}.png ${MY_PN}.png
	done
	newicon --size 256 native/icons/128x128\@2x.png ${MY_PN}.png
}
